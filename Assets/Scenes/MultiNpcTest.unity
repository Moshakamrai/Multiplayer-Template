  m_Script: {fileID: 11500000, guid: c64f14f0e7ec61141a50cde599a9edce, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  itemName: the Rust-Cutter
  basePrice: 100
  hiddenFloor: 55
  shoutVolume: 0.35
  PendingInterruption: 0
  secrets:
  - id: the-ear
    hint: "He NEVER tells the true story of his missing ear \u2014 he deflects with
      a different ridiculous fake story every time he is asked."
    content: "THE TRUTH about the ear: he bet it in a card game he was WINNING, until
      his partner Vessa swapped the deck. He let her keep the ear because he loved
      her. Still does. He only admits this to someone he genuinely respects \u2014
      and he goes quiet and sincere when he does."
    minRespect: 55
    minFear: 0
    triggerWord: 
  - id: the-debt
    hint: "The top name on his napkin ledger is not someone who owes HIM \u2014 it
      is who HE owes. He gets twitchy if the arena Bookie comes up."
    content: 'THE TRUTH about the debt: Griz owes the arena Bookie 4,000 gold and
      the shop itself is collateral. If word spreads he is finished. When this comes
      out he panics, admits it, then immediately begs the player to keep it quiet.'
    minRespect: 0
    minFear: 99
    triggerWord: bookie
